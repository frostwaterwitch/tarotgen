<!DOCTYPE html>
<html>
<head>
    <title>Tarot Generator</title>
  <style>
  body {
  font-family: Arial, sans-serif;
  text-align: center;
  background-color: #191919;
  color: #D4D4D4;
}
button {
  padding: 10px 20px;
  font-size: 18px;
  cursor: pointer;
  background-color: #6baed6;
  color: #D4D4D4;
  border: none;
  border-radius: 5px;
  margin-top: 20px;
}
#result {
    margin-top: 30px;
    font-size: 24px;
    min-height: 40px;
    transition: 0.4s ease;
}

.shuffle {
    animation: shuffle 0.1s infinite;
    opacity: 0.7;
}

@keyframes shuffle {
    0% { transform: translateX(-3px); }
    50% { transform: translateX(3px); }
    100% { transform: translateX(-3px); }
}

.reveal {
    animation: reveal 0.6s ease forwards;
}

@keyframes reveal {
    0% { opacity: 0; transform: scale(0.8); }
    100% { opacity: 1; transform: scale(1); }
}

</style>
</head>
  <body>
    <div id="app">
  <h1>Tarot Card Pull</h1>
  <button id="generateBtn">Generate</button>
  <div id="result">Click Generate</div>
</div>

  <script>
  document.getElementById("generateBtn").addEventListener("click", function () {

    var resultDiv = document.getElementById("result");

    resultDiv.classList.remove("reveal");
    resultDiv.classList.add("shuffle");
    resultDiv.innerText = "Shuffling the deck...";

    setTimeout(function () {

        // Generate random number 1–78
        var randomNumber = Math.floor(Math.random() * 78) + 1;

        // Determine orientation
        var orientation = Math.random() < 0.5 
    ? "Upright 🔆" 
    : "Reversed 🌑";


        resultDiv.classList.remove("shuffle");
        resultDiv.classList.add("reveal");

        resultDiv.innerText =
            "Card: " + randomNumber + " (" + orientation + ")";

    }, 1200); // Shuffle duration (milliseconds)

});

</script>
  </body>
  </html>
</
